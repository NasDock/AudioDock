{
  "name": "sound-x",
  "private": true,
  "version": "1.2.4",
  "productName": "AudioDock",
  "author": "mmdctjj <mmdctjj@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmdctjj/AudioDock"
  },
  "homepage": "https://github.com/mmdctjj/AudioDock",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:win": "cross-env VITE_PLATFORM=win tauri dev --target x86_64-pc-windows-msvc",
    "dev:win:arm64": "cross-env VITE_PLATFORM=win tauri dev --target aarch64-pc-windows-msvc",
    "dev:mac": "cross-env VITE_PLATFORM=mac tauri dev --target universal-apple-darwin",
    "dev:mac:arm64": "cross-env VITE_PLATFORM=mac tauri dev --target aarch64-apple-darwin",
    "dev:mac:x64": "cross-env VITE_PLATFORM=mac tauri dev --target x86_64-apple-darwin",
    "dev:linux": "cross-env VITE_PLATFORM=linux tauri dev",
    "build": "tsc -b && vite build",
    "build:win": "cross-env VITE_PLATFORM=win tsc -b && vite build && tauri build --target x86_64-pc-windows-msvc",
    "build:win:arm64": "cross-env VITE_PLATFORM=win tsc -b && vite build && tauri build --target aarch64-pc-windows-msvc",
    "build:mac": "cross-env VITE_PLATFORM=mac tsc -b && vite build && tauri build --target universal-apple-darwin",
    "build:mac:arm64": "cross-env VITE_PLATFORM=mac tsc -b && vite build && tauri build --target aarch64-apple-darwin",
    "build:mac:x64": "cross-env VITE_PLATFORM=mac tsc -b && vite build && tauri build --target x86_64-apple-darwin",
    "build:linux": "cross-env VITE_PLATFORM=linux tsc -b && vite build && tauri build",
    "build:web": "cross-env VITE_PLATFORM=web tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@soundx/db": "workspace:*",
    "@soundx/i18e": "workspace:*",
    "@soundx/services": "workspace:*",
    "@soundx/ws": "workspace:*",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-autostart": "2.5.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-http": "2.5.9",
    "@tauri-apps/plugin-os": "2.3.2",
    "@tauri-apps/plugin-shell": "2.3.5",
    "ahooks": "^3.9.6",
    "antd": "^5.29.1",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "i18next": "^26.0.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "remark-gfm": "^4.0.1",
    "sass": "^1.94.2",
    "socket.io-client": "^4.8.1",
    "vite-plugin-svgr": "^4.5.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.4.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-svgr": "^4.5.0"
  }
}
