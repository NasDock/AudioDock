// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../generated" /// 自定义为源代码目录内的相对路径
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TrackType {
  MUSIC
  AUDIOBOOK
}

enum FileStatus {
  ACTIVE
  TRASHED
}

enum MetadataSource {
  EMBEDDED
  PLUGIN
  USER_EDITED
}

// 单曲文件来源：本地文件扫描 / WebDAV 同步
enum TrackSource {
  FILE
  WEBDAV
}

model Track {
  id             Int       @id @default(autoincrement())
  name           String
  fileName       String?
  relativePath   String?
  path           String
  artist         String
  album          String
  cover          String?
  duration       Int?
  lyrics         String?
  index          Int? // Track order within the album
  type           TrackType @default(MUSIC)
  createdAt      DateTime  @default(now())
  fileCreatedAt  DateTime?
  fileModifiedAt DateTime?
  scanOrder      Int?
  episodeNumber  Int?      @default(0)

  // Fingerprinting and Soft Delete
  fileHash  String?
  status    FileStatus @default(ACTIVE)
  trashedAt DateTime?

  // Transcoding
  transcodedPath String?

  // Metadata source tracking
  metadataSource   MetadataSource @default(EMBEDDED)
  metadataProvider String?

  // 文件来源：本地文件 or WebDAV
  source TrackSource @default(FILE)

  // Plugin-driven tags (JSON-serialized string array)
  tags String?

  // Relations to entity tables (Optional for compatibility with existing string fields)
  artistId     Int?
  artistEntity Artist? @relation(fields: [artistId], references: [id])
  albumId      Int?
  albumEntity  Album?  @relation(fields: [albumId], references: [id])

  /// 🔁 反向关系
  likedByUsers               UserTrackLike[]
  listenedByUsers            UserTrackHistory[]
  likedAsAudiobookByUsers    UserAudiobookLike[]
  listenedAsAudiobookByUsers UserAudiobookHistory[]
  playlists                  Playlist[]
  folderId                   Int?
  folder                     Folder?                @relation(fields: [folderId], references: [id])
  mvs                        Mv[]

  @@index([fileHash])
  @@index([status])
}

model Album {
  id     Int       @id @default(autoincrement())
  name   String
  artist String
  cover  String?
  year   String?
  type   TrackType @default(MUSIC)

  status    FileStatus @default(ACTIVE)
  trashedAt DateTime?

  // Metadata source tracking
  metadataSource   MetadataSource @default(EMBEDDED)
  metadataProvider String?

  // Plugin-driven enrichment (JSON-serialized)
  description String?
  tags        String?

  tracks Track[]
  mvs    Mv[]

  /// 🔁 反向关系
  likedByUsers    UserAlbumLike[]
  listenedByUsers UserAlbumHistory[]
  collectionItems AudiobookCollectionAlbum[]

  @@index([status])
}

model Artist {
  id     Int       @id @default(autoincrement())
  name   String
  avatar String?
  type   TrackType @default(MUSIC)

  status    FileStatus @default(ACTIVE)
  trashedAt DateTime?

  // Metadata source tracking
  metadataSource   MetadataSource @default(EMBEDDED)
  metadataProvider String?

  // Plugin-driven enrichment (JSON-serialized)
  description String?
  tags        String?

  tracks Track[]
  mvs    Mv[]

  @@index([status])
}

model AudiobookCollection {
  id        Int       @id @default(autoincrement())
  name      String
  cover     String?
  type      TrackType @default(AUDIOBOOK)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  items AudiobookCollectionAlbum[]

  @@index([userId])
  @@index([type])
}

model AudiobookCollectionAlbum {
  id           Int                 @id @default(autoincrement())
  collection   AudiobookCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId Int
  album        Album               @relation(fields: [albumId], references: [id])
  albumId      Int
  order        Int                 @default(0)
  createdAt    DateTime            @default(now())

  @@unique([collectionId, albumId])
  @@index([collectionId, order])
}

model UserTrackLike {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  track     Track    @relation(fields: [trackId], references: [id])
  trackId   Int
  createdAt DateTime @default(now())
}

model UserTrackHistory {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  track      Track    @relation(fields: [trackId], references: [id])
  trackId    Int
  listenedAt DateTime @default(now())
  progress   Int      @default(0)
  deviceName String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId   Int
  isSyncMode Boolean  @default(false)
}

model UserAlbumLike {
  /// 主键 ID，自增
  id        Int      @id @default(autoincrement())
  /// 外键：关联用户
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  /// 外键：关联专辑
  album     Album    @relation(fields: [albumId], references: [id])
  albumId   Int
  /// 用户点赞该专辑的时间
  createdAt DateTime @default(now())
}

model UserAlbumHistory {
  /// 主键 ID，自增
  id         Int      @id @default(autoincrement())
  /// 外键：关联用户
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  /// 外键：关联专辑
  album      Album    @relation(fields: [albumId], references: [id])
  albumId    Int
  /// 用户收听该专辑的时间
  listenedAt DateTime @default(now())
}

model UserAudiobookLike {
  /// 主键 ID，自增
  id        Int      @id @default(autoincrement())
  /// 外键：关联用户
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  /// 外键：关联有声书 Track
  track     Track    @relation(fields: [trackId], references: [id])
  trackId   Int
  /// 用户点赞该有声书的时间
  createdAt DateTime @default(now())
}

model UserAudiobookHistory {
  /// 主键 ID，自增
  id         Int      @id @default(autoincrement())
  /// 外键：关联用户
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  /// 外键：关联有声书 Track
  track      Track    @relation(fields: [trackId], references: [id])
  trackId    Int
  /// 用户收听该有声书的时间
  listenedAt DateTime @default(now())
  progress   Int      @default(0)

  @@unique([userId, trackId])
}

model User {
  /// 用户 ID，自增主键
  id                   Int                    @id @default(autoincrement())
  /// 用户名，唯一标识，用于登录
  username             String                 @unique
  /// 加密后的用户密码
  password             String
  /// 用户头像
  avatar               String?
  /// 是否为管理员用户，默认 false
  is_admin             Boolean                @default(false)
  /// 用户过离期日期，如果为 null 则永久有效
  expiresAt            DateTime?
  /// 用户创建时间
  createdAt            DateTime               @default(now())
  /// 用户喜欢的音乐单曲列表
  likedTracks          UserTrackLike[]
  /// 用户听过的音乐单曲历史记录
  listenedTracks       UserTrackHistory[]
  /// 用户喜欢的专辑列表
  likedAlbums          UserAlbumLike[]
  /// 用户听过的专辑历史记录
  listenedAlbums       UserAlbumHistory[]
  /// 用户喜欢的有声书列表
  likedAudiobooks      UserAudiobookLike[]
  /// 用户听过的有声书历史记录
  listenedAudiobooks   UserAudiobookHistory[]
  /// 用户创建的播放列表
  playlists            Playlist[]
  /// 用户创建的有声书合集
  audiobookCollections AudiobookCollection[]
  /// 用户设备列表
  devices              Device[]
  /// 用户搜索记录
  searchRecords        SearchRecord[]
}

model SystemSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model SearchRecord {
  id        Int      @id @default(autoincrement())
  keyword   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
}

model Device {
  id        Int                @id @default(autoincrement())
  name      String
  /// 稳定唯一设备标识（各端首次启动生成 UUID 并持久化）
  deviceId  String?
  /// 设备平台：desktop / web / tablet / phone / mini / tv / watch
  platform  String?
  /// 最后活跃时间（心跳或 WS 连接时刷新）
  lastSeen  DateTime?
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  isOnline  Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  histories UserTrackHistory[]

  @@unique([userId, deviceId])
}

model Playlist {
  id        Int       @id @default(autoincrement())
  name      String
  type      TrackType @default(MUSIC)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  tracks Track[]
}

model Folder {
  id       Int       @id @default(autoincrement())
  path     String    @unique // 文件夹的唯一路径
  name     String
  parentId Int? // 指向父文件夹
  parent   Folder?   @relation("SubFolders", fields: [parentId], references: [id])
  children Folder[]  @relation("SubFolders")
  type     TrackType @default(MUSIC)
  tracks   Track[]
}

model TtsUserConfig {
  id         Int      @id @default(autoincrement())
  engineName String   @map("engine_name")
  configJson String   @map("config_json")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("tts_user_config")
}

model TtsTask {
  id                String           @id @default(uuid())
  bookName          String           @map("book_name")
  author            String
  filePath          String           @default("") @map("file_path")
  provider          String           @default("edge")
  voice             String           @default("zh-CN-XiaoxiaoNeural")
  speed             Float            @default(1.0)
  totalChapters     Int              @map("total_chapters")
  completedChapters Int              @default(0) @map("completed_chapters")
  status            String           @default("pending")
  createdAt         DateTime         @default(now()) @map("created_at")
  options           String? // Store as JSON string
  chapters          TtsChapterTask[]

  @@map("tts_task")
}

model Mv {
  id             Int       @id @default(autoincrement())
  name           String
  path           String
  artist         String?
  album          String?
  cover          String?
  duration       Int?
  createdAt      DateTime  @default(now())
  fileModifiedAt DateTime?

  // Fingerprinting and Soft Delete
  fileHash  String?
  status    FileStatus @default(ACTIVE)
  trashedAt DateTime?

  // Relations to entity tables
  artistId     Int?
  artistEntity Artist? @relation(fields: [artistId], references: [id])
  albumId      Int?
  albumEntity  Album?  @relation(fields: [albumId], references: [id])
  trackId      Int?
  trackEntity  Track?  @relation(fields: [trackId], references: [id])

  @@index([fileHash])
  @@index([status])
}

model TtsChapterTask {
  id         Int     @id @default(autoincrement())
  taskId     String  @map("task_id")
  task       TtsTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  index      Int
  title      String
  status     String  @default("pending")
  errorMsg   String? @map("error_msg")
  outputPath String? @map("output_path")

  @@map("tts_chapter_task")
}

model PluginLog {
  id         Int      @id @default(autoincrement())
  pluginId   String
  pluginName String?
  targetPath String
  targetType String
  input      String
  output     String?
  status     String
  durationMs Int?
  message    String?
  createdAt  DateTime @default(now())

  @@index([targetPath])
  @@index([pluginId])
  @@index([createdAt])
}
